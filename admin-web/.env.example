# 复制为 .env.development / .env.uat / .env.prod 后按环境填写（勿提交含密钥的本地文件）
VITE_APP_ENV=
VITE_APP_BASE_API=/
VITE_APP_TITLE=钱坤云直播平台
# TOS 原生桶域名（上传代理 / 下载回源）；例 https://qky-live-sucai-test.tos-cn-shanghai.volces.com
VITE_APP_TOS_NATIVE_URL=
# TOS CDN 加速域名（访问/预览 URL）；local/uat：https://qklive-testcos.cjs99.com ；prod 待下发
VITE_APP_TOS_CDN_URL=

# 管理端登录：AppID / redirect_uri 只能写在 env，代码禁止硬编码域名路径
VITE_WECHAT_APPID=
# development 示例：http://wx.qktz.com.cn/api/v1/auth/wechat/callback（本地 Vite :80）
# uat/prod 示例：https://wx.qktz.com.cn/api/v1/auth/wechat/callback（与开放平台回调域一致，nginx 转发；以运维为准）
VITE_WECHAT_REDIRECT_URI=
# 可选；未设时 DEV→false（顶层跳），uat/prod 构建→true（iframe）
# VITE_WECHAT_SELF_REDIRECT=
VITE_AUTH_PASSWORD_AES_KEY_BASE64=

# 订单中心根地址（默认 http://fadada-notify.scqkxx.com）
# 开发态：vite 把 /order-center 代理到该地址；构建态：请求拼绝对 URL
# VITE_ORDER_CENTER_BASE_URL=http://fadada-notify.scqkxx.com

