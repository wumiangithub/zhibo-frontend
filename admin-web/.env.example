# 按 mode 复制后填写，文件名必须与 Vite mode 一致（这些文件已被 gitignore，勿提交密钥）：
#   .env.development  本地开发   npm run dev
#   .env.test         测试环境   npm run build:test
#   .env.uat          预发环境   npm run build:uat
#   .env.production   生产环境   npm run build
# 本地 VITE_APP_ENV 必须写 dev（代码用它判断是否走 Vite 代理）。其余环境写 test / uat / production。
VITE_APP_ENV=
# Vite 开发端口。仅 npm run dev 读取；本地微信扫码须 80。
ADMIN_WEB_PORT=80
# 开发态 /api 代理端口，须与后端 ADMIN_SERVER_PORT 一致。仅 npm run dev 读取。
ADMIN_SERVER_PORT=8081
# 观众端 live-web 根地址（含协议和端口）。各环境可以不同。
# VITE_LIVE_WEB_ORIGIN=http://localhost:5174
VITE_APP_BASE_API=/
VITE_APP_TITLE=钱坤云直播平台
# TOS 原生桶域名（上传代理 / 下载回源）
# development/test：https://qky-live-sucai-test.tos-cn-shanghai.volces.com
# uat：https://qky-live-sucai-uat.tos-cn-shanghai.volces.com
# production：https://qky-live-sucai-prod.tos-cn-shanghai.volces.com
VITE_APP_TOS_NATIVE_URL=
# TOS CDN 加速域名（访问/预览 URL）
# development/test：https://qklive-testcos.cjs99.com
# uat / production：加速域名未下发前暂填各自原生桶域名
VITE_APP_TOS_CDN_URL=

# 管理端登录：AppID / redirect_uri 只能写在 env，代码禁止硬编码域名路径
VITE_WECHAT_APPID=
# development 示例：http://wx.qktz.com.cn/api/v1/auth/wechat/callback（本地 Vite :80）
# 预发/生产示例：https://wx.qktz.com.cn/api/v1/auth/wechat/callback（与开放平台回调域一致，nginx 转发；以运维为准）
VITE_WECHAT_REDIRECT_URI=
# 可选；未设时 DEV→false（顶层跳），test/uat/production 构建→true（iframe）
# VITE_WECHAT_SELF_REDIRECT=
VITE_AUTH_PASSWORD_AES_KEY_BASE64=

# 订单中心根地址。未配时构建态默认 http://oms-api.scqkxx.com；生产域名另配
# 开发态：vite 把 /order-center 代理到该地址；构建态：请求拼绝对 URL
# VITE_ORDER_CENTER_BASE_URL=http://oms-api.scqkxx.com
