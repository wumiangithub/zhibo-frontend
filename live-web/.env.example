# 按 mode 复制后填写，文件名必须与 Vite mode 一致（这些文件已被 gitignore）：
#   .env.development  本地开发   npm run dev
#   .env.test         测试环境   npm run build:test
#   .env.uat          预发环境   npm run build:uat
#   .env.production   生产环境   npm run build

# Vite 开发端口。仅 npm run dev 读取。须与 admin-web 的 VITE_LIVE_WEB_ORIGIN 端口一致。
LIVE_WEB_PORT=5174
# 开发态 /api 代理端口，须与后端 LIVE_SERVER_PORT 一致。仅 npm run dev 读取。
LIVE_SERVER_PORT=8082

# 订单中心 Base（无尾斜杠）。开发态 Vite 把 /order-center 代理到此；构建态直连。
# 未配时代码默认 http://oms-api.scqkxx.com
# VITE_ORDER_CENTER_BASE_URL=http://oms-api.scqkxx.com

# 文档预览：原生桶强制下载，须配 CDN（与 admin-web 同桶）
# development/test：
# VITE_APP_TOS_NATIVE_URL=https://qky-live-sucai-test.tos-cn-shanghai.volces.com
# VITE_APP_TOS_CDN_URL=https://qklive-testcos.cjs99.com
# uat（加速域名未下发前 CDN 与原生相同）：
# VITE_APP_TOS_NATIVE_URL=https://qky-live-sucai-uat.tos-cn-shanghai.volces.com
# VITE_APP_TOS_CDN_URL=https://qky-live-sucai-uat.tos-cn-shanghai.volces.com
# production：
# VITE_APP_TOS_NATIVE_URL=https://qky-live-sucai-prod.tos-cn-shanghai.volces.com
# VITE_APP_TOS_CDN_URL=  待生产加速域名下发；未下发前暂填原生桶域名
